{
  "name": "sidedoor",
  "version": "0.1.0",
  "description": "Turn a website with no API into a JSON endpoint and an MCP tool from one plain-English sentence, powered by Kane CLI.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sidedoor": "bin/sidedoor.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "portal": "node portal/server.mjs",
    "start": "node scripts/start.mjs",
    "snapshot": "tsx scripts/snapshot.ts",
    "prepare": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  }
}
