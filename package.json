{
  "name": "@himxsh/sidedoor",
  "version": "0.1.0",
  "description": "Turn a website with no API into a JSON endpoint and an MCP tool from one plain-English sentence, powered by Kane CLI.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kane-cli",
    "browser-automation",
    "web-scraping",
    "api",
    "agent",
    "testmu"
  ],
  "homepage": "https://getsidedoor.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himxsh/Sidedoor.git"
  },
  "bugs": {
    "url": "https://github.com/himxsh/Sidedoor/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sidedoor": "bin/sidedoor.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "bin/",
    "web/index.html",
    "web/app.js",
    "web/style.css",
    "web/icons/favicon-32.png",
    "web/icons/apple-touch-icon.png",
    "web/icons/logo-96.png",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "portal": "node portal/server.mjs",
    "start": "node scripts/start.mjs",
    "snapshot": "tsx scripts/snapshot.ts",
    "prepare": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  }
}
